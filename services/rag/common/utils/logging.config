[loggers]
keys=root, ailogger

[handlers]
keys=consoleHandler
; keys=consoleHandler, fileHandler
[formatters]
keys=simpleFormatter

[logger_root]
level=INFO
handlers=consoleHandler

[logger_ailogger]
level=DEBUG
handlers=consoleHandler
qualname=ailogger
propagate=0

[handler_consoleHandler]
class=StreamHandler
level=DEBUG
formatter=simpleFormatter
args=(sys.stdout,)

[handler_fileHandler1]
class=FileHandler
level=INFO
formatter=simpleFormatter
args=('onepi_aichat_appinfo0.log', 'a')

[handler_fileHandler]
class=handlers.RotatingFileHandler
level=INFO
formatter=simpleFormatter
args=('onepi_aichat_appINF1.log', 'a', 5121024, 20)
#-filename, mode, maxBytes, backupCount

[formatter_simpleFormatter]
format=%(asctime)s - %(levelname)s  - %(message)s

